{
  "_sec_vision": {
    "description": "=== 看视频 ===",
    "type": "text",
    "invisible": true
  },
  "vision_provider_id": {
    "description": "视觉模型 provider id",
    "type": "string",
    "default": "",
    "hint": "填 AstrBot 里配置好的多模态模型 id，例如 deepseek/deepseek-vision。"
  },
  "frames": {
    "description": "抽帧数量",
    "type": "int",
    "default": 6,
    "slider": {
      "min": 1,
      "max": 30,
      "step": 1
    },
    "hint": "越多越准，也越费钱/越慢。"
  },
  "max_seconds": {
    "description": "最长视频时长（秒）",
    "type": "int",
    "default": 600,
    "slider": {
      "min": 10,
      "max": 3600,
      "step": 10
    }
  },
  "frame_width": {
    "description": "抽帧宽度（像素）",
    "type": "int",
    "default": 640,
    "slider": {
      "min": 320,
      "max": 1920,
      "step": 32
    }
  },
  "_sec_rewrite": {
    "description": "=== 说话方式 ===",
    "type": "text",
    "invisible": true
  },
  "rewrite": {
    "description": "把事实重写成人格口吻",
    "type": "bool",
    "default": true
  },
  "rewrite_provider": {
    "description": "重写用的文本模型 id",
    "type": "string",
    "default": "",
    "condition": {
      "rewrite": true
    }
  },
  "history_turns": {
    "description": "参考最近几轮对话",
    "type": "int",
    "default": 6,
    "slider": {
      "min": 0,
      "max": 20,
      "step": 2
    }
  },
  "_sec_search": {
    "description": "=== 识图与联网（可选） ===",
    "type": "text",
    "invisible": true
  },
  "image_search": {
    "description": "认不出时用百度识图",
    "type": "bool",
    "default": true,
    "hint": "需要 bsk（browser-skill）可用。"
  },
  "bsk_path": {
    "description": "bsk.exe 路径",
    "type": "string",
    "default": "",
    "hint": "留空用 PATH 里的 bsk。不填且没装 bsk 时，识图会自动跳过。"
  },
  "bsk_browser": {
    "description": "bsk 浏览器实例 id",
    "type": "string",
    "default": "",
    "hint": "留空自动获取并记住第一个实例。"
  },
  "search_key": {
    "description": "搜索接口 API Key",
    "type": "string",
    "default": "",
    "hint": "留空则不联网补充。"
  },
  "search_api": {
    "description": "搜索接口地址",
    "type": "string",
    "default": "https://api.deepseek.com/v1/tools/search"
  },
  "_sec_link": {
    "description": "=== 网页链接（B站/抖音等） ===",
    "type": "text",
    "invisible": true
  },
  "yt_dlp": {
    "description": "yt-dlp 路径",
    "type": "text",
    "default": "",
    "hint": "留空会自动找 PATH 与常见安装位置；找不到就得填，比如 .agent-reach-venv\\Scripts\\yt-dlp.exe。"
  },
  "ytdlp_seconds": {
    "description": "只下载前几秒",
    "type": "int",
    "default": 30,
    "slider": {
      "min": 5,
      "max": 300,
      "step": 5
    },
    "hint": "整条视频又慢又占盘，看开头几十秒通常就够判断内容。"
  },
  "ytdlp_height": {
    "description": "下载画质上限",
    "type": "int",
    "default": 480,
    "slider": {
      "min": 144,
      "max": 1080,
      "step": 16
    },
    "hint": "视觉模型吃不了太大的图，480 足够。"
  },
  "cookies_browser": {
    "description": "从哪个浏览器取 cookies",
    "type": "string",
    "default": "",
    "options": [
      "",
      "edge",
      "chrome",
      "firefox"
    ],
    "labels": [
      "不带",
      "Edge",
      "Chrome",
      "Firefox"
    ],
    "hint": "抖音这类站点要 cookies 才肯给视频；浏览器正开着时可能读不到（数据库被占），那就靠下面的浏览器兜底。"
  },
  "browser_fallback": {
    "description": "下不下来时用浏览器截帧",
    "type": "bool",
    "default": true,
    "hint": "用 bsk 打开页面，把画面区域截几张图交给视觉模型。抖音基本走这条路。"
  },
  "browser_shots": {
    "description": "浏览器截几帧",
    "type": "int",
    "default": 4,
    "slider": {
      "min": 1,
      "max": 10,
      "step": 1
    },
    "condition": {
      "browser_fallback": true
    }
  },
  "browser_settle": {
    "description": "打开页面后等几秒",
    "type": "int",
    "default": 5,
    "slider": {
      "min": 1,
      "max": 20,
      "step": 1
    },
    "condition": {
      "browser_fallback": true
    },
    "hint": "等页面把播放器渲染出来再截。"
  },
  "persona_data_dir": {
    "type": "string",
    "description": "人格数据目录（可选）",
    "hint": "给 persona_mind 的 plugin_data 目录，用来借她平时的语气与心情；留空按同级插件自动推断",
    "default": ""
  },
  "_sec_see": {
    "type": "text",
    "invisible": true,
    "description": "让她自己看（把画面直接交给主模型）"
  },
  "see_with_llm": {
    "type": "bool",
    "description": "画面直接给你自己看",
    "default": true,
    "hint": "打开后：收到视频/视频链接时不再由插件代你看再转述，而是把截出来的画面直接塞进这一次请求，你用自己的话说。要求主模型是多模态（AstrBot 里该 provider 的 modalities 含 image）。"
  },
  "see_shots": {
    "type": "int",
    "description": "一次给几帧",
    "default": 3,
    "slider": {
      "min": 1,
      "max": 6,
      "step": 1
    },
    "condition": {
      "see_with_llm": true
    },
    "hint": "帧数越多信息越全，token 也越多；3 帧通常够看清在讲什么。"
  },
  "see_cache_seconds": {
    "type": "int",
    "description": "同一条链接多久内不重复抽帧",
    "default": 600,
    "slider": {
      "min": 60,
      "max": 3600,
      "step": 60
    },
    "condition": {
      "see_with_llm": true
    },
    "hint": "同一条视频反复讨论时复用缓存的帧，省掉一次下载或开浏览器。"
  },
  "see_timeout": {
    "type": "int",
    "description": "一条链接最多等多久（秒）",
    "default": 90,
    "slider": {
      "min": 30,
      "max": 300,
      "step": 10
    },
    "condition": {
      "see_with_llm": true
    },
    "hint": "超时就不带画面、直接回话，别让整条消息卡住。抖音这类走浏览器的一般 40 秒内。"
  }
}
